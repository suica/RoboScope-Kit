+    @contextmanager
+    def preserve_current(self):
+        """Restore the interrupted EGL binding after temporary owning-context work."""
+        previous_api = EGL.eglQueryAPI()
+        previous_context = EGL.eglGetCurrentContext()
+        previous_display = EGL.eglGetCurrentDisplay()
+        previous_draw = EGL.eglGetCurrentSurface(EGL.EGL_DRAW)
